# Public URL of the app, no trailing slash. Must match the redirect URI registered
# in Google Cloud: ${APP_URL}/auth/google/callback
APP_URL=http://localhost:3000

# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 random bytes, base64. Encrypts Google tokens at rest. Generate with:
#   openssl rand -base64 32
# Keep it secret and stable: changing it makes stored Google tokens unreadable
# (users would just need to reconnect Gmail).
APP_SECRET=

# PostgreSQL connection string. On Neon use the *pooled* connection string
# (host contains "-pooler"); Vercel's Neon integration sets this for you.
# For local development, a Neon dev branch or any local Postgres works:
#   DATABASE_URL=postgres://user:password@localhost:5432/ledger
DATABASE_URL=
