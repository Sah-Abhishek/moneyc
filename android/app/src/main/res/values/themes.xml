<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MoneyControl" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
    </style>

    <!-- Shown while the app starts: the masthead's M on paper. -->
    <style name="Theme.MoneyControl.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MoneyControl</item>
    </style>
</resources>
